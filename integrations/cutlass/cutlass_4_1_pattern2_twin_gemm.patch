+/*! \file
+    \brief Lightweight fused launcher for two initialized CUTLASS 2.x GEMM device operators.
+*/
+
+#pragma once
+
+#include <algorithm>
+
+#include "cuda_runtime_api.h"
+
+#include "cutlass/arch/synclog.hpp"
+#include "cutlass/cutlass.h"
+#include "cutlass/device_kernel.h"
+
+////////////////////////////////////////////////////////////////////////////////
+
+namespace cutlass {
+namespace gemm {
+namespace device {
+namespace detail {
+
+////////////////////////////////////////////////////////////////////////////////
+
+template <typename GemmKernel0, typename GemmKernel1>
+CUTLASS_GLOBAL
+void TwinKernel(
+    typename GemmKernel0::Params params0,
+    typename GemmKernel1::Params params1,
+    int gemm0_grid_size) {
+  extern __shared__ int SharedStorageBase[];
+
+  if (int(blockIdx.x) < gemm0_grid_size) {
+    typename GemmKernel0::SharedStorage *shared_storage =
+        reinterpret_cast<typename GemmKernel0::SharedStorage *>(SharedStorageBase);
+    GemmKernel0 op;
+    op(params0, *shared_storage, 0, true);
+  } else {
+    typename GemmKernel1::SharedStorage *shared_storage =
+        reinterpret_cast<typename GemmKernel1::SharedStorage *>(SharedStorageBase);
+    GemmKernel1 op;
+    op(params1, *shared_storage, gemm0_grid_size, true);
+  }
+
+  cutlass::arch::synclog_print();
+}
+
+////////////////////////////////////////////////////////////////////////////////
+
+} // namespace detail
+
+////////////////////////////////////////////////////////////////////////////////
+
+template <typename GEMMOperator0, typename GEMMOperator1>
+class TwinGemm {
+ public:
+  using GemmKernel0 = typename GEMMOperator0::GemmKernel;
+  using GemmKernel1 = typename GEMMOperator1::GemmKernel;
+  using Arguments0 = typename GEMMOperator0::Arguments;
+  using Arguments1 = typename GEMMOperator1::Arguments;
+
+ private:
+  class DeviceWorkspace {
+   public:
+    DeviceWorkspace() = default;
+
+    DeviceWorkspace(DeviceWorkspace const &) = delete;
+    DeviceWorkspace &operator=(DeviceWorkspace const &) = delete;
+
+    ~DeviceWorkspace() {
+      if (ptr_) {
+        cudaFree(ptr_);
+      }
+    }
+
+    Status reset(size_t bytes) {
+      if (bytes == bytes_ && (bytes == 0 || ptr_)) {
+        return Status::kSuccess;
+      }
+
+      if (ptr_) {
+        cudaError_t result = cudaFree(ptr_);
+        ptr_ = nullptr;
+        bytes_ = 0;
+
+        if (result != cudaSuccess) {
+          return Status::kErrorInternal;
+        }
+      }
+
+      if (bytes == 0) {
+        return Status::kSuccess;
+      }
+
+      cudaError_t result = cudaMalloc(&ptr_, bytes);
+      if (result != cudaSuccess) {
+        ptr_ = nullptr;
+        bytes_ = 0;
+        return Status::kErrorInternal;
+      }
+
+      bytes_ = bytes;
+      return Status::kSuccess;
+    }
+
+    void *get() const {
+      return ptr_;
+    }
+
+   private:
+    void *ptr_ = nullptr;
+    size_t bytes_ = 0;
+  };
+
+ public:
+  GEMMOperator0 gemm0;
+  GEMMOperator1 gemm1;
+
+  TwinGemm() = default;
+
+  TwinGemm(TwinGemm const &) = delete;
+  TwinGemm &operator=(TwinGemm const &) = delete;
+
+  Status initialize_op0(Arguments0 const &args, cudaStream_t stream = nullptr) {
+    return initialize_impl<GEMMOperator0>(gemm0, workspace0_, args, stream);
+  }
+
+  Status initialize_op1(Arguments1 const &args, cudaStream_t stream = nullptr) {
+    return initialize_impl<GEMMOperator1>(gemm1, workspace1_, args, stream);
+  }
+
+  template <typename ElementA, typename ElementB, typename ElementC, typename Alpha, typename Beta>
+  Status initialize_op0(
+      int m,
+      int n,
+      int k,
+      ElementA *ptr_A,
+      ElementB *ptr_B,
+      ElementC *ptr_C,
+      int split_k_slices,
+      Alpha alpha,
+      Beta beta,
+      cudaStream_t stream = nullptr) {
+    Arguments0 arguments(
+        {m, n, k},
+        {ptr_A, k},
+        {ptr_B, k},
+        {ptr_C, m},
+        {ptr_C, m},
+        {alpha, beta},
+        split_k_slices);
+
+    return initialize_op0(arguments, stream);
+  }
+
+  template <typename ElementA, typename ElementB, typename ElementC, typename Alpha, typename Beta>
+  Status initialize_op1(
+      int m,
+      int n,
+      int k,
+      ElementA *ptr_A,
+      ElementB *ptr_B,
+      ElementC *ptr_C,
+      int split_k_slices,
+      Alpha alpha,
+      Beta beta,
+      cudaStream_t stream = nullptr) {
+    Arguments1 arguments(
+        {m, n, k},
+        {ptr_A, k},
+        {ptr_B, k},
+        {ptr_C, m},
+        {ptr_C, m},
+        {alpha, beta},
+        split_k_slices);
+
+    return initialize_op1(arguments, stream);
+  }
+
+  Status run(cudaStream_t stream = nullptr) {
+    int gemm0_grid_size = gemm0.get_grid_size();
+    int gemm1_grid_size = gemm1.get_grid_size();
+
+    if (gemm0_grid_size <= 0 || gemm1_grid_size <= 0) {
+      return Status::kErrorInvalidProblem;
+    }
+
+    int grid_size = gemm0_grid_size + gemm1_grid_size;
+    int block_size = std::max(gemm0.get_block_size(), gemm1.get_block_size());
+    int smem_size = std::max(gemm0.get_smem_size(), gemm1.get_smem_size());
+
+    if (smem_size >= (48 << 10)) {
+      cudaError_t result = cudaFuncSetAttribute(
+          detail::TwinKernel<GemmKernel0, GemmKernel1>,
+          cudaFuncAttributeMaxDynamicSharedMemorySize,
+          smem_size);
+
+      if (result != cudaSuccess) {
+        return Status::kErrorInternal;
+      }
+    }
+
+    cutlass::arch::synclog_setup();
+
+    dim3 grid(grid_size, 1, 1);
+    dim3 block(block_size, 1, 1);
+    detail::TwinKernel<GemmKernel0, GemmKernel1>
+        <<<grid, block, smem_size, stream>>>(gemm0.get_param(), gemm1.get_param(), gemm0_grid_size);
+
+    cudaError_t result = cudaGetLastError();
+    return result == cudaSuccess ? Status::kSuccess : Status::kErrorInternal;
+  }
+
+ private:
+  template <typename GEMMOperator, typename Arguments>
+  static Status initialize_impl(
+      GEMMOperator &gemm,
+      DeviceWorkspace &workspace,
+      Arguments const &args,
+      cudaStream_t stream) {
+    size_t workspace_size = GEMMOperator::get_workspace_size(args);
+    Status status = workspace.reset(workspace_size);
+    if (status != Status::kSuccess) {
+      return status;
+    }
+
+    return gemm.initialize(args, workspace.get(), stream);
+  }
+
+ private:
+  DeviceWorkspace workspace0_;
+  DeviceWorkspace workspace1_;
+};
