+def _record_linear_profile(backend: str, layer: torch.nn.Module, m: int, n: int,
+                           k: int, ms: float) -> None:
+    prefix = getattr(layer, "prefix", "") or "<unknown>"
+    key = (backend, prefix, m, n, k)
+    flops = 2.0 * float(m) * float(n) * float(k)
+    with _MOONPOLY_LINEAR_PROFILE_LOCK:
+        item = _MOONPOLY_LINEAR_PROFILE.get(key)
+        if item is None:
+            item = {
+                "backend": backend,
+                "layer_prefix": prefix,
+                "m": m,
+                "n": n,
+                "k": k,
+                "count": 0,
+                "total_ms": 0.0,
+                "max_ms": 0.0,
+                "total_tflops": 0.0,
+            }
+            _MOONPOLY_LINEAR_PROFILE[key] = item
+        item["count"] += 1
+        item["total_ms"] += float(ms)
+        item["max_ms"] = max(float(item["max_ms"]), float(ms))
+        if ms > 0.0:
+            item["total_tflops"] += flops / (float(ms) * 1.0e9)
+
+
+def _profile_linear_call(backend: str, layer: torch.nn.Module, x_2d: torch.Tensor,
+                         w: torch.Tensor, fn):
+    _ensure_linear_profile_exit_handler()
+    start = torch.cuda.Event(enable_timing=True)
+    stop = torch.cuda.Event(enable_timing=True)
+    start.record()
+    out = fn()
+    stop.record()
+    stop.synchronize()
+    ms = float(start.elapsed_time(stop))
+    _record_linear_profile(backend, layer, int(x_2d.shape[0]), int(w.shape[0]),
+                           int(x_2d.shape[1]), ms)
+    return out
+
