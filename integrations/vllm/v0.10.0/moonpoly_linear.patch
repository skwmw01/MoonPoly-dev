+def _profile_linear_should_record(x_2d: torch.Tensor, w: torch.Tensor) -> bool:
+    if not _profile_linear_enabled():
+        return False
+    if x_2d.device.type != "cuda" or w.device.type != "cuda":
+        return False
+    if x_2d.dtype != torch.float16 or w.dtype != torch.float16:
+        return False
+    max_m = _profile_linear_max_m()
+    if max_m > 0 and int(x_2d.shape[0]) > max_m:
+        return False
+    return True
