+def _safe_warn(msg: str, *args: Any) -> None:
+    # TorchDynamo in compile-mode may reject logger calls in graphable code paths.
+    if _is_compiling():
+        return
+    logger.warning(msg, *args)
+
+
+def _safe_info(msg: str, *args: Any) -> None:
+    if _is_compiling():
+        return
+    logger.info(msg, *args)
