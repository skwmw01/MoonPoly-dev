+def _apply_moonpoly_streamk_linear(layer: torch.nn.Module, x_2d: torch.Tensor,
+                                   w: torch.Tensor) -> Optional[torch.Tensor]:
+    global _MOONPOLY_WS_WARNED
+
+    if not _use_moonpoly_streamk():
+        _streamk_stats_inc("skipped_disabled")
+        return None
+
+    m = int(x_2d.shape[0])
+    n = int(w.shape[0])
+    k = int(x_2d.shape[1])
+    # Hardcoded deployment gate: only known-safe model dims may enter StreamK.
+    if m >= 16 or n < 5120 or k < 5120 or n not in _STREAMK_ALLOWED_N or k not in _STREAMK_ALLOWED_K:
+        _streamk_stats_inc("skipped_hardcode")
+        return None
+
+    if not _streamk_shape_allowed(m, n, k):
+        _streamk_stats_inc("skipped_gate")
+        return None
+
+    ws_size_op = _moonpoly_ws_size_op()
+    linear_ws_op = _moonpoly_linear_ws_out_op()
+    if ws_size_op is None or linear_ws_op is None:
+        _streamk_stats_inc("skipped_missing_ops")
+        return None
+
+    pid = _moonpoly_streamk_pid()
+    split_k = _moonpoly_streamk_split_k()
