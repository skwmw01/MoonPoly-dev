+def _parse_int_set_env(name: str) -> set[int]:
+    raw = os.getenv(name, "").strip()
+    if not raw:
+        return set()
+    vals: set[int] = set()
+    for tok in raw.split(","):
+        tok = tok.strip()
+        if not tok:
+            continue
+        vals.add(int(tok))
+    return vals
