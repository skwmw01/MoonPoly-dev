+def _streamk_shape_allowed(m: int, n: int, k: int) -> bool:
+    # Deployment hard gate first.
+    if m >= 16:
+        return False
+    if n < 5120 or k < 5120:
+        return False
+    if n not in _STREAMK_ALLOWED_N or k not in _STREAMK_ALLOWED_K:
+        return False
+
+    max_m = _streamk_max_m()
+    if max_m > 0 and m > max_m:
+        return False
+
+    allow_m = _streamk_allow_m_set()
+    if allow_m and m not in allow_m:
+        return False
+
+    allow_n = _streamk_allow_n_set()
+    if allow_n and n not in allow_n:
+        return False
+
+    allow_k = _streamk_allow_k_set()
+    if allow_k and k not in allow_k:
+        return False
+
+    return True
+
