+def _dump_linear_profile() -> None:
+    path = _profile_linear_out_path()
+    if not path:
+        return
+    with _MOONPOLY_LINEAR_PROFILE_LOCK:
+        rows = []
+        total_ms = 0.0
+        for item in _MOONPOLY_LINEAR_PROFILE.values():
+            row = dict(item)
+            row["avg_ms"] = (row["total_ms"] / row["count"]
+                             if row["count"] else 0.0)
+            row["avg_tflops"] = (row["total_tflops"] / row["count"]
+                                 if row["count"] else 0.0)
+            total_ms += float(row["total_ms"])
+            rows.append(row)
+    rows.sort(key=lambda x: float(x["total_ms"]), reverse=True)
+    summary = {
+        "rows": rows,
+        "total_ms": total_ms,
+        "num_entries": len(rows),
+    }
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(summary, f, indent=2)
+    if rows:
+        top = rows[:10]
+        _safe_info("MoonPoly linear decode-like profile written to %s", path)
+        for row in top:
+            share = (100.0 * float(row["total_ms"]) / total_ms
+                     if total_ms > 0.0 else 0.0)
+            _safe_info(
+                "Linear profile: backend=%s layer=%s shape=(%d,%d,%d) "
+                "count=%d avg_ms=%.4f total_ms=%.4f share=%.2f%%",
+                row["backend"],
+                row["layer_prefix"],
+                row["m"],
+                row["n"],
+                row["k"],
+                row["count"],
+                row["avg_ms"],
+                row["total_ms"],
+                share,
+            )
