+def _lookup_decode_selector(m: int, n: int,
+                            k: int) -> Optional[tuple[int, int]]:
+    return _MOONPOLY_MERGED_DECODE_SELECTOR.get((m, n, k))
+
+
+def _moonpoly_get_workspace(device: torch.device,
+                            required_bytes: int) -> torch.Tensor:
+    req = max(int(required_bytes), 1)
+    stream = torch.cuda.current_stream(device=device)
+    stream_id = int(stream.cuda_stream)
+    key = (int(device.index if device.index is not None else 0), stream_id)
+    with _MOONPOLY_WS_POOL_LOCK:
+        buf = _MOONPOLY_WS_POOL.get(key)
+        if buf is None or buf.numel() < req:
+            buf = torch.empty((req,), device=device, dtype=torch.uint8)
+            _MOONPOLY_WS_POOL[key] = buf
+        return buf
+
