+def _ensure_linear_profile_exit_handler() -> None:
+    global _MOONPOLY_LINEAR_PROFILE_REGISTERED
+    if _MOONPOLY_LINEAR_PROFILE_REGISTERED:
+        return
+    with _MOONPOLY_LINEAR_PROFILE_LOCK:
+        if _MOONPOLY_LINEAR_PROFILE_REGISTERED:
+            return
+        atexit.register(_dump_linear_profile)
+        _MOONPOLY_LINEAR_PROFILE_REGISTERED = True
